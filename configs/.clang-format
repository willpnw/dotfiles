---
BasedOnStyle: LLVM
UseTab: Never
ColumnLimit: 150
IndentWidth: 4
TabWidth: 4
IndentCaseLabels: true
AllowShortFunctionsOnASingleLine: None
SpaceBeforeParens: Never
AccessModifierOffset: -4
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: 'stdafx'
    Priority: -2
  - Regex: '<'
    Priority: -1
  - Regex: '.h'
    Priority: 1
BreakBeforeBraces: Custom
BraceWrapping:
  AfterEnum: true
