[user]
	email = william.patterson@spx.com
	name = will
[pull]
	rebase = true
	default = current
[diff]
    prompt = false
	tool = bcompare
	guitool = bcompare
[merge]
    prompt = false
	tool = bcompare
	guitool = bcompare
[difftool "bcompare"]
    prompt = false
    cmd = \"/mnt/c/Program Files/Beyond Compare 5/BCompare.exe\" \"$(wslpath -aw $LOCAL)\" \"$(wslpath -aw $REMOTE)\"
[mergetool "bcompare"]
    prompt = false
    cmd = \"/mnt/c/Program Files/Beyond Compare 5/BCompare.exe\" \"$(wslpath -aw $LOCAL)\" \"$(wslpath -aw $REMOTE)\" \"$(wslpath -aw $BASE)\" \"$(wslpath -aw $MERGED)\"
[push]
	default = current
[core]
	pager = less -F -X
	excludesFile = ~/dotfiles/configs/.gitignore
	autocrlf = input
[format]
	pretty = format:%C(auto)%h %d%Creset %s%n%Cgreen%ad%Creset %aN <%aE>%n
[color]
	ui = auto
[http]
	 sslVerify = false
[oh-my-zsh]
	hide-info = 1
